# Generated by Cargo: compiled files and executables.
/target/

# Backup files generated by rustfmt.
**/*.rs.bk

# MSVC Windows builds of rustc (pdb debug info).
*.pdb

# macOS metadata.
.DS_Store

# Editor swap/lock files.
*.swp
*.swo
*~

# Local-only service drop-ins (may carry personal flags/env).
*.service.d/

# JetBrains IDE project files.
.idea/
